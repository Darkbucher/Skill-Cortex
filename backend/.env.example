# .env.example — copy to .env and fill in real values before running
# NEVER commit .env to version control — it contains secrets.

# ── Database ──────────────────────────────────────────────────────────────
# Local dev default: Postgres running via docker-compose on port 5432
DATABASE_URL=postgresql://skillcortex:skillcortex@localhost:5432/skillcortex

# ── Clerk (Phase 1 — leave as placeholder until Phase 1 begins) ───────────
# Get these from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# ── Auth / Domain ─────────────────────────────────────────────────────────
# College Google Workspace domain. Only accounts with this domain suffix
# are allowed to authenticate. Enforced server-side on EVERY request (see
# core/security.py). Replace before deployment — do NOT hardcode elsewhere.
COLLEGE_DOMAIN=college.ac.in

# ── Security ──────────────────────────────────────────────────────────────
# Random secret used for internal signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string

# ── CORS ──────────────────────────────────────────────────────────────────
# Frontend origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173
