# .gitignore for SkillCortex backend

# Virtual environment
.venv/
venv/
env/

# Environment variables — NEVER commit real secrets
.env

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Alembic (don't ignore the migrations folder — only temp files)
alembic/versions/*.pyc
